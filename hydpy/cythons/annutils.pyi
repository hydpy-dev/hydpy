# pylint: disable=missing-docstring

from hydpy.core.typingtools import *

class ANN:
    # required for usage as an "algorithm" by interputils:
    nmb_inputs: int
    nmb_outputs: int
    @property
    def inputs(self) -> FastAccessVector[float]: ...
    @inputs.setter
    def inputs(self, value: VectorFloat) -> None: ...
    @property
    def outputs(self) -> FastAccessVector[float]: ...
    @outputs.setter
    def outputs(self, value: VectorFloat) -> None: ...
    @property
    def output_derivatives(self) -> FastAccessVector[float]: ...
    @output_derivatives.setter
    def output_derivatives(self, value: VectorFloat) -> None: ...
    def calculate_values(self) -> None: ...
    def calculate_derivatives(self, idx: int, /) -> None: ...
    # algorithm-specific requirements:
    nmb_layers: int
    @property
    def nmb_neurons(self) -> FastAccessVector[int]: ...
    @nmb_neurons.setter
    def nmb_neurons(self, value: VectorInt) -> None: ...
    @property
    def weights_input(self) -> FastAccessMatrix[float]: ...
    @weights_input.setter
    def weights_input(self, value: MatrixFloat) -> None: ...
    @property
    def weights_output(self) -> FastAccessMatrix[float]: ...
    @weights_output.setter
    def weights_output(self, value: MatrixFloat) -> None: ...
    @property
    def weights_hidden(self) -> FastAccessTensor[float]: ...
    @weights_hidden.setter
    def weights_hidden(self, value: TensorFloat) -> None: ...
    @property
    def intercepts_hidden(self) -> FastAccessMatrix[float]: ...
    @intercepts_hidden.setter
    def intercepts_hidden(self, value: MatrixFloat) -> None: ...
    @property
    def intercepts_output(self) -> FastAccessVector[float]: ...
    @intercepts_output.setter
    def intercepts_output(self, value: VectorFloat) -> None: ...
    @property
    def activation(self) -> FastAccessMatrix[int]: ...
    @activation.setter
    def activation(self, value: MatrixInt) -> None: ...
    @property
    def neurons(self) -> FastAccessMatrix[float]: ...
    @neurons.setter
    def neurons(self, value: MatrixFloat) -> None: ...
    @property
    def neuron_derivatives(self) -> FastAccessMatrix[float]: ...
    @neuron_derivatives.setter
    def neuron_derivatives(self, value: MatrixFloat) -> None: ...
