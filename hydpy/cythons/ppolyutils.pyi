# pylint: disable=missing-docstring

from hydpy.core.typingtools import *
from hydpy.auxs import ppolytools

class PPoly:
    # required for usage as an "algorithm" by interputils:
    nmb_inputs: int
    nmb_outputs: int
    @property
    def inputs(self) -> FastAccessVector[float]: ...
    @inputs.setter
    def inputs(self, value: VectorFloat) -> None: ...
    @property
    def outputs(self) -> FastAccessVector[float]: ...
    @outputs.setter
    def outputs(self, value: VectorFloat) -> None: ...
    @property
    def output_derivatives(self) -> FastAccessVector[float]: ...
    @output_derivatives.setter
    def output_derivatives(self, value: VectorFloat) -> None: ...
    def calculate_values(self) -> None: ...
    def calculate_derivatives(self, idx: int, /) -> None: ...
    # algorithm-specific requirements:
    nmb_ps: int
    @property
    def nmb_cs(self) -> FastAccessVector[int]: ...
    @nmb_cs.setter
    def nmb_cs(self, value: VectorInt) -> None: ...
    @property
    def x0s(self) -> FastAccessVector[float]: ...
    @x0s.setter
    def x0s(self, value: VectorFloat) -> None: ...
    @property
    def cs(self) -> FastAccessMatrix[float]: ...
    @cs.setter
    def cs(self, value: MatrixFloat) -> None: ...
    def find_index(self) -> int: ...

class PPolys:
    # required for usage as an "algorithm" by interputils:
    @property
    def inputs(self) -> FastAccessVector[float]: ...
    @inputs.setter
    def inputs(self, value: VectorFloat) -> None: ...
    @property
    def outputs(self) -> FastAccessVector[float]: ...
    @outputs.setter
    def outputs(self, value: VectorFloat) -> None: ...
    @property
    def output_derivatives(self) -> FastAccessVector[float]: ...
    @output_derivatives.setter
    def output_derivatives(self, value: VectorFloat) -> None: ...
    def calculate_values(self) -> None: ...
    def calculate_derivatives(self, idx: int, /) -> None: ...
    # algorithm-specific requirements:
    nmb_ppolys: int
    @property
    def options(self) -> FastAccessVector[int]: ...
    @options.setter
    def options(self, value: VectorInt) -> None: ...
    def __init__(
        self, ppolys: Iterable[ppolytools.PPoly | ppolytools.PPolysOptions]
    ) -> None: ...
